    "Outbound could not start its renderer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Outbound تشغيل محرك العرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound konnte seinen Renderer nicht starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound no pudo iniciar su motor de renderizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound n'a pas pu démarrer son moteur de rendu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound अपना रेंडरर शुरू नहीं कर सका।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound non è riuscito ad avviare il motore di rendering."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Outboundの描画エンジンを起動できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound가 렌더러를 시작하지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound kon de renderer niet starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound nie mógł uruchomić renderowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Outbound não conseguiu iniciar o renderizador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound не смог запустить отрисовку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound görüntü motorunu başlatamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound 无法启动渲染器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound 無法啟動繪圖引擎。"
          }
        }
      }
    },
    "Outbound couldn't reach the store. Check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Outbound الوصول إلى المتجر. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound konnte den Shop nicht erreichen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound no pudo conectar con la tienda. Revisa tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound n'a pas pu joindre la boutique. Vérifie ta connexion et réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound स्टोर से कनेक्ट नहीं हो सका। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound non riesce a contattare il negozio. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Outboundがストアに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound가 스토어에 연결하지 못했습니다. 연결 상태를 확인한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound kan de winkel niet bereiken. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound nie może połączyć się ze sklepem. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Outbound não conseguiu acessar a loja. Verifique sua conexão e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound не может связаться с магазином. Проверьте подключение и попробуйте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound mağazaya ulaşamadı. Bağlantını denetleyip yeniden dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound 无法连接商店。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound 無法連上商店。請檢查網路連線後再試一次。"
          }
        }
      }
    },
    "Outbound is already unlocked here with another key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فتح قفل Outbound هنا بالفعل بمفتاح آخر."
          }
