    "The store had a problem (%lld). Please try again in a moment.": {
      "comment": "%lld is an HTTP status code.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واجه المتجر مشكلة (%lld). يُرجى المحاولة مرة أخرى بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Shop ist ein Problem aufgetreten (%lld). Bitte versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tienda tuvo un problema (%lld). Vuelve a intentarlo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La boutique a rencontré un problème (%lld). Réessaie dans un instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टोर में कोई समस्या आई (%lld)। कृपया थोड़ी देर में फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il negozio ha avuto un problema (%lld). Riprova tra un attimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアで問題が発生しました（%lld）。少し待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스토어에 문제가 발생했습니다(%lld). 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De winkel had een probleem (%lld). Probeer het zo nog eens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sklep zgłosił problem (%lld). Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A loja teve um problema (%lld). Tente de novo daqui a pouco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка на стороне магазина (%lld). Попробуйте ещё раз чуть позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mağazada bir sorun oluştu (%lld). Lütfen birazdan yeniden dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商店出现问题（%lld）。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商店發生問題（%lld）。請稍後再試一次。"
          }
        }
      }
    },
    "This key is already in use on three Macs. Free one up in Outbound's settings on that Mac, or in your customer portal, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المفتاح مستخدم بالفعل على ثلاثة أجهزة Mac. حرّر أحدها من إعدادات Outbound على ذلك الجهاز أو من بوابة العملاء، ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel wird bereits auf drei Macs verwendet. Gib einen davon in den Outbound-Einstellungen auf dem betreffenden Mac oder in deinem Kundenportal frei und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave ya está en uso en tres Mac. Libera uno desde los ajustes de Outbound en ese Mac o desde tu portal de cliente, y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé est déjà utilisée sur trois Mac. Libères-en un dans les réglages d'Outbound sur ce Mac-là, ou dans ton espace client, puis réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कुंजी पहले से 3 Mac पर इस्तेमाल हो रही है। उनमें से किसी Mac पर Outbound की सेटिंग्ज़ में या अपने कस्टमर पोर्टल में एक Mac को निष्क्रिय करें, फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chiave è già in uso su tre Mac. Liberane uno dalle impostazioni di Outbound su quel Mac o dal tuo portale clienti, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーはすでに3台のMacで使われています。そのうち1台のOutboundの設定か、カスタマーポータルで解除してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 이미 Mac 3대에서 사용 중입니다. 해당 Mac의 Outbound 설정이나 고객 포털에서 한 대를 해제한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze sleutel is al in gebruik op drie Macs. Maak er een vrij in de instellingen van Outbound op die Mac, of in je klantportaal, en probeer het dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten klucz jest już używany na trzech Macach. Zwolnij jeden w ustawieniach Outbound na tamtym Macu lub w portalu klienta, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave já está em uso em três Macs. Libere um nos ajustes do Outbound naquele Mac ou no seu portal do cliente e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот ключ уже используется на трёх Mac. Освободите один в настройках Outbound на том Mac или в кабинете покупателя, а затем попробуйте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anahtar zaten üç Mac'te kullanılıyor. O Mac'teki Outbound ayarlarından ya da müşteri portalından birini boşalt, sonra yeniden dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此激活码已在 3 台 Mac 上使用。请在其中一台 Mac 的 Outbound 设置或客户中心里取消激活一台，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這組授權碼已在 3 台 Mac 上使用。請在其中一台 Mac 的 Outbound 設定或客戶中心裡停用一台，然後再試一次。"
          }
        }
      }
    },
