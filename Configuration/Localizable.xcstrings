    "Couldn't save your license. You may be asked for it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ ترخيصك. قد يُطلب منك مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Lizenz konnte nicht gespeichert werden. Eventuell wirst du erneut danach gefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar tu licencia. Puede que se te vuelva a pedir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer ta licence. Elle pourra t'être redemandée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका लाइसेंस सहेजा नहीं जा सका। हो सकता है आपसे इसे फिर से माँगा जाए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la licenza. Potrebbe esserti richiesta di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライセンスを保存できませんでした。もう一度入力を求められることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스를 저장하지 못했습니다. 다시 입력해야 할 수도 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je licentie kon niet worden bewaard. Misschien wordt er nog een keer om gevraagd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać licencji. Być może trzeba będzie podać ją ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar sua licença. Ela pode ser pedida de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить лицензию. Возможно, ключ попросят ввести снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisansın kaydedilemedi. Yeniden sorulabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存你的授权，之后可能需要重新输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存你的授權，之後可能需要重新輸入。"
          }
        }
      }
    },
