        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别该激活码。请与感谢页面或客户中心里的激活码核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
