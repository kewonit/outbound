    "Connect to the internet so Outbound can check your license.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بالإنترنت ليتمكن Outbound من التحقق من ترخيصك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit dem Internet, damit Outbound deine Lizenz prüfen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a internet para que Outbound pueda comprobar tu licencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à Internet pour qu'Outbound puisse vérifier ta licence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट से कनेक्ट करें, ताकि Outbound आपका लाइसेंस जाँच सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti a internet per permettere a Outbound di verificare la tua licenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Outboundがライセンスを確認できるよう、インターネットに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound가 라이선스를 확인할 수 있도록 인터넷에 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met het internet, zodat Outbound je licentie kan controleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z internetem, aby Outbound mógł sprawdzić licencję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se à internet para que o Outbound possa verificar sua licença."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к интернету, чтобы Outbound мог проверить лицензию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound'un lisansını doğrulayabilmesi için internete bağlan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接互联网，以便 Outbound 验证你的授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請連上網際網路，讓 Outbound 確認你的授權。"
          }
        }
      }
    },
