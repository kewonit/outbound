        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛, 계절, 속도 등 나머지 설정은 메뉴 막대의 갈매기 아이콘에서 고를 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht, seizoenen, tempo en de andere keuzes vind je in de menubalk, onder de meeuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Światło, pory roku, tempo i pozostałe opcje znajdziesz na pasku menu, pod mewą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz, estações, ritmo e as demais opções ficam na barra de menus, no menu da gaivota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освещение, времена года, темп и остальные настройки находятся в строке меню, под чайкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işık, mevsimler, hız ve diğer tüm seçenekler menü çubuğunda, martının altında."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光线、季节、速度等其他选项，都在菜单栏的海鸥图标里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "光線、季節、速度等其他選項，都在選單列的海鷗圖像裡。"
          }
        }
      }
    },
