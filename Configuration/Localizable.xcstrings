    "A painted world behind your desktop, and a bird that follows your cursor.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عالم مرسوم خلف سطح مكتبك، وطائر يتبع المؤشر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gemalte Welt hinter deinem Schreibtisch und ein Vogel, der deinem Mauszeiger folgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mundo pintado detrás de tu escritorio y un pájaro que sigue tu cursor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un monde peint derrière ton bureau, et un oiseau qui suit ton curseur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डेस्कटॉप के पीछे रंगों से बनी एक दुनिया, और आपके कर्सर के पीछे-पीछे उड़ती एक चिड़िया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mondo dipinto dietro la tua scrivania e un uccello che segue il tuo cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップの奥に広がる描かれた世界と、カーソルについてくる一羽の鳥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크탑 뒤로 펼쳐지는 그림 속 세상, 그리고 커서를 따라다니는 새 한 마리."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een geschilderde wereld achter je bureaublad, en een vogel die je cursor volgt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Malowany świat w tle biurka i ptak, który podąża za kursorem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mundo pintado atrás da sua área de trabalho e um pássaro que segue o seu cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисованный мир за рабочим столом и птица, которая летит за курсором."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstünün ardında tablo gibi bir dünya ve imlecini izleyen bir kuş."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "藏在桌面背后的画中世界，还有一只追着光标飞的鸟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藏在桌面後方的畫中世界，還有一隻跟著游標飛的鳥。"
          }
        }
      }
    },
    "A still of the current view, kept as the desktop picture.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صورة ثابتة للمشهد الحالي، تبقى صورةً لسطح المكتب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Standbild der aktuellen Ansicht, als Schreibtischhintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imagen fija de la vista actual, como fondo del escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image fixe de la vue actuelle, gardée comme fond d'écran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा नज़ारे की एक स्थिर तस्वीर, डेस्कटॉप चित्र के रूप में।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'immagine fissa della vista attuale, come sfondo della scrivania."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまの景色の静止画を、デスクトップピクチャにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 풍경의 정지 화면을 데스크탑 사진으로 둡니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een stilstaand beeld van wat je nu ziet, als bureaubladachtergrond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieruchomy kadr z bieżącego widoku jako obraz biurka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem parada da vista atual como imagem da mesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподвижный кадр текущего вида в качестве картинки рабочего стола."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O anki görüntüden sabit bir kare, masaüstü resmi olarak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将当前景色的静止画面用作桌面图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將目前景色的靜態畫面用作桌面圖片。"
          }
        }
      }
    },
    "Active on %@": {
