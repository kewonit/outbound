    "Too many tries in a row. Wait a moment, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة متتالية. انتظر قليلًا ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche hintereinander. Warte kurz und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos seguidos. Espera un momento y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives d'affilée. Patiente un instant, puis réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगातार बहुत ज़्यादा कोशिशें हो गईं। थोड़ा रुकें, फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi di fila. Aspetta un attimo, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けて何度も試行されました。少し待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속으로 너무 많이 시도했습니다. 잠시 기다린 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel pogingen achter elkaar. Wacht even en probeer het dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele prób z rzędu. Odczekaj chwilę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas seguidas. Espere um pouco e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток подряд. Подождите немного и попробуйте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka arkaya çok fazla deneme yapıldı. Biraz bekle, sonra yeniden dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续尝试次数过多。请稍候再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續嘗試太多次。請稍候再試一次。"
          }
        }
      }
    },
