    "Already bought it? Paste your key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتريته بالفعل؟ الصق مفتاحك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon gekauft? Füge deinen Schlüssel ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya lo compraste? Pega tu clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà acheté ? Colle ta clé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले ही ख़रीद चुके हैं? अपनी कुंजी पेस्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già acquistato? Incolla la tua chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入済みなら、ライセンスキーをペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 구입하셨나요? 키를 붙여넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al gekocht? Plak je sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już kupione? Wklej klucz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já comprou? Cole sua chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже купили? Вставьте ключ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten satın aldın mı? Anahtarını yapıştır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经购买？粘贴你的激活码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經購買了嗎？請貼上你的授權碼。"
          }
        }
      }
    },
