    "Finish paying in your browser. Outbound unlocks by itself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل الدفع في متصفحك. سيُفتح قفل Outbound تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließ die Zahlung im Browser ab. Outbound wird dann von selbst freigeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina el pago en tu navegador. Outbound se desbloqueará solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine le paiement dans ton navigateur. Outbound se débloquera tout seul."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने ब्राउज़र में भुगतान पूरा करें। Outbound अपने-आप अनलॉक हो जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa il pagamento nel browser. Outbound si sbloccherà da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでお支払いを済ませてください。Outboundは自動でロック解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 결제를 마쳐 주세요. Outbound는 자동으로 잠금 해제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond de betaling af in je browser. Outbound ontgrendelt vanzelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokończ płatność w przeglądarce. Outbound odblokuje się sam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua o pagamento no navegador. O Outbound se desbloqueia sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите оплату в браузере. Outbound разблокируется сам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödemeyi tarayıcında tamamla. Outbound'un kilidi kendiliğinden açılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在浏览器中完成付款，Outbound 会自动解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在瀏覽器中完成付款，Outbound 會自動解鎖。"
          }
        }
      }
    },
