    </item>
    <item>
      <title>Outbound v1.2</title>
      <pubDate>Mon, 26 Oct 2026 17:27:39 +0000</pubDate>
      <description><![CDATA[<p>Light, seasons, pace, time at each place and battery choices are now in the menu bar, under a new gull icon. Settings always opens in front of your other windows.</p>]]></description>
      <sparkle:version>4</sparkle:version>
      <sparkle:shortVersionString>1.2</sparkle:shortVersionString>
