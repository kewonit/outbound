{
  // The website: the pages Astro builds into Website/dist (npm run build, which wrangler runs first), and a small API
  // under /api/ in worker/index.js that hands a buyer's license key to the app. Deploys from main through Workers
  // Builds, or with npx wrangler deploy. npm run preview builds and serves it all locally.
  //
  // Secrets, set once and kept across deploys with npx wrangler secret put NAME: POLAR_ACCESS_TOKEN, and for the
  // waitlist and feedback SUPABASE_URL, SUPABASE_KEY and WAITLIST_TOKEN (worker/supabase.sql). Locally they go in
  // .dev.vars.
  "name": "outbound",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./Website/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*", "/buy", "/download", "/", "/support", "/thanks", "/waitlist", "/feedback", "/*/", "/*/support", "/*/thanks",
      "/*/waitlist", "/*/feedback", "/license", "/privacy", "/terms"
    ]
  },
  "vars": {
    "POLAR_API": "https://api.polar.sh",
    // What the site sells: Outbound for 1 Mac, and its license key benefit (1 activation).
    "POLAR_PRODUCT_ID": "NEW-1-MAC-PRODUCT-ID",
    "POLAR_BENEFIT_ID": "NEW-1-MAC-BENEFIT-ID",
    // What the app's Buy sells: Outbound for up to 3 Macs, as its buy window says up to 1.8.1, and every key bought
    // before 13 November 2026.
    "POLAR_APP_PRODUCT_ID": "e7c27b2b-6c8d-4514-82dc-9f6ad3394928",
    "POLAR_APP_BENEFIT_ID": "b08abf7f-b1d6-4b01-aec0-37aabfbbae54",
    // Polar's own checkout link for Outbound for 1 Mac, where the site's Buy goes when a checkout can't be made.
    "POLAR_CHECKOUT_LINK": "NEW-1-MAC-CHECKOUT-LINK"
  },
  "ratelimits": [
    { "name": "CHECKOUTS", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOOKUPS", "namespace_id": "1102", "simple": { "limit": 60, "period": 60 } },
    { "name": "WAITLIST", "namespace_id": "1103", "simple": { "limit": 5, "period": 60 } },
    { "name": "FEEDBACK", "namespace_id": "1104", "simple": { "limit": 5, "period": 60 } }
  ],
  "routes": [{ "pattern": "outbound.edbn.me", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
