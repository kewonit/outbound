{
  // The website, served as static assets. Deploy with: npx wrangler deploy
  "name": "outbound",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./Website",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "outbound.edbn.me", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
