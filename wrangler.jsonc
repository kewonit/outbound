{
  // The website: static files from Website/, and a small API under /api/ in worker/index.js that hands
  // a buyer's license key to the app. Deploys from main through Workers Builds, or with npx wrangler deploy.
  //
  // One secret, set once and kept across deploys: npx wrangler secret put POLAR_ACCESS_TOKEN
  "name": "outbound",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./Website",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*", "/buy", "/download", "/", "/support", "/thanks", "/*/", "/*/support", "/*/thanks", "/license", "/privacy"
    ]
  },
  "vars": {
    "POLAR_API": "https://api.polar.sh",
    "POLAR_PRODUCT_ID": "e7c27b2b-6c8d-4514-82dc-9f6ad3394928",
    "POLAR_BENEFIT_ID": "b08abf7f-b1d6-4b01-aec0-37aabfbbae54",
    // Polar's own checkout link for Outbound, where the site's Buy goes when a checkout can't be made.
    "POLAR_CHECKOUT_LINK": "https://buy.polar.sh/polar_cl_2WXlRKhLcEPJSQ0KnyuM3gQNFurhMbUrD99Gl4EQHLA",
    // Your City in Outbound: a buyer's city painted in, with the same license key benefit.
    "POLAR_CITY_PRODUCT_ID": "a1589a31-9bb3-4d5a-a647-edf5e1f54a71"
  },
  "ratelimits": [
    { "name": "CHECKOUTS", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOOKUPS", "namespace_id": "1102", "simple": { "limit": 60, "period": 60 } }
  ],
  "routes": [{ "pattern": "outbound.edbn.me", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
